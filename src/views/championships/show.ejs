<%- include('../partials/header') %>
<div class="page-head">
  <h1 id="championship-name"><%= championship.name %></h1>
  <span id="championship-status" class="badge"><%= labels.CHAMPIONSHIP_DISPLAY_STATUS[championship.displayStatus] %></span>
  <% if (canRegister) { %>
    <a id="register-button" class="button" href="/championships/<%= championship.id %>/register">Inscrever</a>
  <% } %>
</div>

<% if (championship.status === 'cancelled') { %>
  <p class="notice">Campeonato cancelado. Motivo: <span id="cancel-reason"><%= championship.cancel_reason %></span></p>
<% } %>

<div class="card">
  <dl class="details">
    <dt>Organizador</dt>
    <dd id="championship-organizer"><%= championship.organizerName %></dd>
    <dt>Modalidade</dt>
    <dd id="championship-sport"><%= labels.SPORTS[championship.sport] %></dd>
    <dt>Categorias</dt>
    <dd id="championship-categories"><%= championship.categories.join(', ') %></dd>
    <dt>Formato</dt>
    <dd id="championship-format"><%= labels.FORMATS[championship.format] %></dd>
    <dt>Local</dt>
    <dd id="championship-venue"><%= championship.venue %> — <%= championship.city_name %></dd>
    <dt>Período</dt>
    <dd id="championship-dates"><%= formatBrDate(championship.start_date) %> a <%= formatBrDate(championship.end_date) %></dd>
    <dt>Inscrições até</dt>
    <dd id="championship-deadline"><%= formatBrDate(championship.registration_deadline) %></dd>
    <% if (championship.max_slots) { %>
      <dt>Vagas por categoria</dt>
      <dd id="championship-slots"><%= championship.max_slots %></dd>
    <% } %>
    <% if (championship.contact) { %>
      <dt>Contato</dt>
      <dd id="championship-contact"><%= championship.contact %></dd>
    <% } %>
    <% if (championship.rules) { %>
      <dt>Regulamento</dt>
      <dd id="championship-rules"><%= championship.rules %></dd>
    <% } %>
  </dl>
</div>

<h2><%= championship.sport === 'street_run' ? 'Participantes inscritos' : 'Equipes inscritas' %></h2>
<div id="approved-entries" class="card">
  <% approved.forEach((c) => { %>
    <div id="approved-category-<%= c.id %>" data-testid="approved-category" class="approved-category">
      <h3><span class="category"><%= c.category %></span>
        <small class="hint">(<span class="slots"><%= championship.max_slots ? `${c.approved}/${championship.max_slots}` : c.approved %></span> aprovadas)</small></h3>
      <% if (c.entries.length === 0) { %>
        <p class="hint">Nenhuma inscrição aprovada ainda.</p>
      <% } else { %>
        <ul>
          <% c.entries.forEach((name) => { %><li data-testid="approved-entry"><%= name %></li><% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>
</div>
<p><a href="/championships">Voltar para os campeonatos</a></p>
<%- include('../partials/footer') %>
