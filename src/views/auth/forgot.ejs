<%- include('../partials/header') %>
<h1>Recuperar senha</h1>
<div class="card">
  <p>Informe o e-mail da sua conta. Enviaremos um link para você criar uma nova senha.</p>
  <form id="forgot-form" class="stacked" method="post" action="/password/forgot" novalidate>
    <div class="field">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" autocomplete="username">
    </div>
    <button type="submit" id="submit">Enviar link</button>
  </form>
  <p><a href="/login">Voltar para o login</a></p>
</div>
<%- include('../partials/footer') %>
